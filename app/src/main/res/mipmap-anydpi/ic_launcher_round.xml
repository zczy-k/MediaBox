<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形版:同样的图形,底色裁成整圆,避免方形底色在圆形遮罩下露角 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M54,54 m-54,0 a54,54 0 1,0 108,0 a54,54 0 1,0 -108,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF16205E" />
                <item android:offset="1.0" android:color="#FF0FA3D8" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:pathData="M38,30 h32 a9,9 0 0 1 9,9 v30 a9,9 0 0 1 -9,9 h-32 a9,9 0 0 1 -9,-9 v-30 a9,9 0 0 1 9,-9 z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M47,42 L68,54 L47,66 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
